@model IEnumerable<HospitalManagementSystem.Models.Prescription>

@{
    ViewData["Title"] = "Prescriptions";

    var prescriptions = Model.ToList();
    var totalPrescriptions = prescriptions.Count;
    var uniquePatients = prescriptions
        .Where(p => p.Patient != null)
        .Select(p => p.PatientId)
        .Distinct()
        .Count();
    var uniqueDoctors = prescriptions
        .Where(p => p.Doctor != null)
        .Select(p => p.DoctorId)
        .Distinct()
        .Count();
    var uniqueMedicines = prescriptions
        .Where(p => p.Medicine != null)
        .Select(p => p.MedicineId)
        .Distinct()
        .Count();
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-prescription2"></i> Prescriptions
            </h1>
            <p class="text-muted mb-0">
                Manage patient prescriptions, medicines and dosage instructions.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Create Prescription
        </a>
    </div>
    
<form asp-controller="Prescriptions"
      asp-action="Index"
      method="get"
      class="row g-2 mb-3">

    <div class="col-md-8">
        <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               class="form-control"
               placeholder="Search prescriptions..." />
    </div>

    <div class="col-auto">
        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>

    <div class="col-auto">
        <a asp-controller="Prescriptions"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>


    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Prescriptions -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-file-medical text-primary fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-1">
                            Total Prescriptions
                        </h6>
                        <h3 class="fw-bold mb-0">
                            @totalPrescriptions
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Patients -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-person-heart text-success fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-1">
                            Patients
                        </h6>
                        <h3 class="fw-bold mb-0">
                            @uniquePatients
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Doctors -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-person-badge text-warning fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-1">
                            Doctors
                        </h6>
                        <h3 class="fw-bold mb-0">
                            @uniqueDoctors
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Medicines -->
        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="bi bi-capsule text-danger fs-3"></i>
                    </div>

                    <div>
                        <h6 class="text-muted mb-1">
                            Medicines
                        </h6>
                        <h3 class="fw-bold mb-0">
                            @uniqueMedicines
                        </h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Prescription Table Card -->
    <div class="card border-0 shadow-sm">

        <!-- Card Header -->
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-1">
                        Prescription Records
                    </h5>

                    <small class="text-muted">
                        @totalPrescriptions prescription(s) found
                    </small>
                </div>

                <span class="badge bg-primary rounded-pill px-3 py-2">
                    Prescription List
                </span>

            </div>
        </div>

        <div class="card-body p-0">

            @if (prescriptions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">#</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Medicine</th>
                                <th>Date</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Duration</th>
                                <th>Instructions</th>
                                <th class="text-center">Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in prescriptions)
                            {
                                <tr>

                                    <!-- Prescription ID -->
                                    <td class="ps-4">
                                        <span class="fw-bold text-primary">
                                            #@item.PrescriptionId
                                        </span>
                                    </td>

                                    <!-- Patient -->
                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div class="bg-success bg-opacity-10
                                                        rounded-circle p-2 me-2">
                                                <i class="bi bi-person text-success"></i>
                                            </div>

                                            <span class="fw-semibold">
                                                @item.Patient?.PatientName
                                            </span>

                                        </div>
                                    </td>

                                    <!-- Doctor -->
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-person-badge"></i>
                                            @item.Doctor?.DoctorName
                                        </span>
                                    </td>

                                    <!-- Medicine -->
                                    <td>
                                        <span class="badge bg-danger bg-opacity-10
                                                     text-danger border border-danger
                                                     px-3 py-2">
                                            <i class="bi bi-capsule"></i>
                                            @item.Medicine?.MedicineName
                                        </span>
                                    </td>

                                    <!-- Date -->
                                    <td>
                                        <span class="text-nowrap">
                                            <i class="bi bi-calendar3 text-primary"></i>
                                            @item.PrescriptionDate.ToString("dd-MM-yyyy")
                                        </span>
                                    </td>

                                    <!-- Dosage -->
                                    <td>
                                        <span class="badge bg-primary">
                                            @item.Dosage
                                        </span>
                                    </td>

                                    <!-- Frequency -->
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @item.Frequency
                                        </span>
                                    </td>

                                    <!-- Duration -->
                                    <td>
                                        <span class="badge bg-secondary">
                                            @item.Duration
                                        </span>
                                    </td>

                                    <!-- Instructions -->
                                    <td style="min-width: 200px;">
                                        @if (!string.IsNullOrWhiteSpace(item.Instructions))
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-info-circle"></i>
                                                @item.Instructions
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No instructions
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center text-nowrap">

                                        <a asp-action="Details"
                                           asp-route-id="@item.PrescriptionId"
                                           class="btn btn-info btn-sm text-white"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.PrescriptionId"
                                           class="btn btn-warning btn-sm"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.PrescriptionId"
                                           class="btn btn-danger btn-sm"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty State -->

                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-prescription2 display-1 text-muted"></i>
                    </div>

                    <h4 class="fw-bold">
                        No Prescriptions Found
                    </h4>

                    <p class="text-muted">
                        There are currently no prescription records.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Create First Prescription
                    </a>

                </div>
            }

        </div>

    </div>

</div>