@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="text-center mb-5">

        <h1 class="fw-bold">
            Privacy Policy
        </h1>

        <p class="text-muted">
            Hospital Management System
        </p>

    </div>


    <!-- Introduction -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Introduction
            </h3>

            <p class="text-muted">
                The Hospital Management System is designed to help
                hospital staff manage patients, doctors, appointments,
                departments, medicines and prescriptions in an organized
                manner.
            </p>

            <p class="text-muted mb-0">
                This Privacy Policy explains how information entered into
                this system is intended to be handled and protected.
            </p>

        </div>

    </div>


    <!-- Information We Manage -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Information Managed by the System
            </h3>

            <p class="text-muted">
                Depending on the features being used, the system may
                contain the following types of information:
            </p>

            <ul class="text-muted">

                <li class="mb-2">
                    Patient names and basic personal information
                </li>

                <li class="mb-2">
                    Contact information such as phone numbers and email
                    addresses
                </li>

                <li class="mb-2">
                    Doctor names, specializations and department information
                </li>

                <li class="mb-2">
                    Appointment dates, times and reasons for visits
                </li>

                <li class="mb-2">
                    Medicine information and stock details
                </li>

                <li class="mb-2">
                    Prescription information, dosage and instructions
                </li>

                <li>
                    Other information entered by authorized system users
                </li>

            </ul>

        </div>

    </div>


    <!-- Use of Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Use of Information
            </h3>

            <p class="text-muted">
                Information stored in the system is intended to support
                hospital administration and healthcare-related
                record management.
            </p>

            <p class="text-muted mb-0">
                The information may be used to manage patient records,
                appointments, doctors, departments, medicines and
                prescriptions.
            </p>

        </div>

    </div>


    <!-- Data Security -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Data Security
            </h3>

            <p class="text-muted">
                Appropriate security practices should be used to protect
                information stored in the Hospital Management System.
            </p>

            <p class="text-muted">
                Access to the system and its database should be limited
                to authorized users. Database credentials and other
                sensitive configuration information should not be shared
                publicly.
            </p>

        </div>

    </div>


    <!-- Patient Privacy -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Patient Privacy
            </h3>

            <p class="text-muted">
                Patient information should be treated as confidential
                information. Authorized hospital personnel should access
                patient records only when required for legitimate
                hospital activities.
            </p>

            <p class="text-muted mb-0">
                Users of the system should avoid sharing patient
                information with unauthorized individuals.
            </p>

        </div>

    </div>


    <!-- Database -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Database Information
            </h3>

            <p class="text-muted">
                The application uses a SQL Server database to store
                information required by the Hospital Management System.
            </p>

            <p class="text-muted mb-0">
                Database access should be properly secured and limited
                to authorized application and administrative processes.
            </p>

        </div>

    </div>


    <!-- User Responsibilities -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                User Responsibilities
            </h3>

            <p class="text-muted">
                Users who have access to the system are responsible for
                protecting their login credentials and for using hospital
                information appropriately.
            </p>

            <ul class="text-muted">

                <li class="mb-2">
                    Do not share passwords with other users.
                </li>

                <li class="mb-2">
                    Do not access records without authorization.
                </li>

                <li class="mb-2">
                    Keep patient information confidential.
                </li>

                <li>
                    Report suspected unauthorized access to the system
                    administrator.
                </li>

            </ul>

        </div>

    </div>


    <!-- Policy Updates -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-body p-4">

            <h3 class="fw-bold text-primary">
                Changes to This Privacy Policy
            </h3>

            <p class="text-muted mb-0">
                This privacy policy may be updated when the Hospital
                Management System or its information-handling practices
                change. Users should review this page periodically for
                updated information.
            </p>

        </div>

    </div>


    <!-- Notice -->
    <div class="alert alert-info mb-5">

        <h5 class="fw-bold">
            Important Notice
        </h5>

        <p class="mb-0">
            This page provides general information about privacy and
            data handling for this project. For a real hospital
            deployment, the organization should establish a privacy
            policy that complies with applicable healthcare, privacy
            and data-protection laws and regulations.
        </p>

    </div>


    <!-- Footer -->
    <div class="text-center py-4 border-top">

        <h5 class="fw-bold">
            Hospital Management System
        </h5>

        <p class="text-muted mb-0">
            Protecting information through responsible system management.
        </p>

    </div>

</div>