
@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid px-0">

    <!-- Hero Section -->
    <div class="bg-primary text-white rounded-3 shadow-sm p-5 mb-5">
        <div class="row align-items-center">

            <div class="col-lg-8">
                <h1 class="display-4 fw-bold">
                    Hospital Management System
                </h1>

                <p class="lead mt-3">
                    A simple and efficient system for managing
                    patients, doctors, appointments, medicines,
                    prescriptions and hospital departments.
                </p>

                <p class="mt-3">
                    This website helps hospital staff organize
                    important healthcare information in one place
                    and makes day-to-day hospital management easier.
                </p>

                <div class="mt-4">
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-light btn-lg me-2 mb-2">
                        🔐 Login
                    </a>

                    <a asp-controller="Patients"
                       asp-action="Index"
                       class="btn btn-outline-light btn-lg me-2 mb-2">
                        Manage Patients
                    </a>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-outline-light btn-lg mb-2">
                        View Appointments
                    </a>
                </div>
            </div>

            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="bg-white text-primary rounded-circle
                    d-inline-flex align-items-center
                    justify-content-center shadow"
                     style="width: 180px; height: 180px;">
                    <span class="fw-bold fs-1">HMS</span>
                </div>

                <p class="mt-3 mb-0">
                    Healthcare Management
                </p>
            </div>

        </div>
    </div>

    <!-- About Website -->
    <div class="row mb-5">

        <div class="col-lg-8">
            <h2 class="fw-bold mb-3">
                About Our Hospital Management System
            </h2>

            <p class="text-muted">
                The Hospital Management System is a web-based application
                designed to simplify the management of hospital operations.
                It provides a centralized platform where authorized hospital
                staff can maintain important records and manage daily
                activities.
            </p>

            <p class="text-muted">
                The system helps manage patient information, doctors,
                departments, appointments, medicines and prescriptions.
                By keeping these records organized, hospital staff can
                quickly access the information they need.
            </p>

            <p class="text-muted">
                This project is developed using
                <strong>ASP.NET Core MVC</strong>,
                <strong>C#</strong>,
                <strong>Entity Framework Core</strong> and
                <strong>SQL Server</strong>.
            </p>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">

                    <h5 class="fw-bold text-primary">
                        System Features
                    </h5>

                    <ul class="list-group list-group-flush mt-3">
                        <li class="list-group-item px-0">
                            Patient Management
                        </li>
                        <li class="list-group-item px-0">
                            Doctor Management
                        </li>
                        <li class="list-group-item px-0">
                            Department Management
                        </li>
                        <li class="list-group-item px-0">
                            Appointment Management
                        </li>
                        <li class="list-group-item px-0">
                            Medicine Management
                        </li>
                        <li class="list-group-item px-0">
                            Prescription Management
                        </li>
                    </ul>

                </div>
            </div>
        </div>

    </div>

    <!-- Hospital Management Modules -->
    <div class="mb-5">

        <div class="text-center mb-4">
            <h2 class="fw-bold">
                Hospital Management Modules
            </h2>

            <p class="text-muted">
                Access the main features of the system
            </p>
        </div>

        <div class="row g-4">

            <!-- Departments -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-primary">
                            Departments
                        </h4>

                        <p class="text-muted">
                            Manage hospital departments and maintain
                            department information.
                        </p>

                        <a asp-controller="Departments"
                           asp-action="Index"
                           class="btn btn-primary">
                            View Departments
                        </a>
                    </div>
                </div>
            </div>

            <!-- Doctors -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-success">
                            Doctors
                        </h4>

                        <p class="text-muted">
                            Manage doctors, their specializations,
                            departments and contact information.
                        </p>

                        <a asp-controller="Doctor"
                           asp-action="Index"
                           class="btn btn-success">
                            View Doctors
                        </a>
                    </div>
                </div>
            </div>

            <!-- Patients -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-info">
                            Patients
                        </h4>

                        <p class="text-muted">
                            Maintain patient information, contact
                            details and medical records.
                        </p>

                        <a asp-controller="Patients"
                           asp-action="Index"
                           class="btn btn-info">
                            View Patients
                        </a>
                    </div>
                </div>
            </div>

            <!-- Appointments -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-warning">
                            Appointments
                        </h4>

                        <p class="text-muted">
                            Schedule and manage appointments between
                            patients and doctors.
                        </p>

                        <a asp-controller="Appointments"
                           asp-action="Index"
                           class="btn btn-warning">
                            View Appointments
                        </a>
                    </div>
                </div>
            </div>

            <!-- Medicines -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-danger">
                            Medicines
                        </h4>

                        <p class="text-muted">
                            Manage medicine information, prices,
                            stock quantities and expiry dates.
                        </p>

                        <a asp-controller="Medicines"
                           asp-action="Index"
                           class="btn btn-danger">
                            View Medicines
                        </a>
                    </div>
                </div>
            </div>

            <!-- Prescriptions -->
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h4 class="fw-bold text-secondary">
                            Prescriptions
                        </h4>

                        <p class="text-muted">
                            Manage patient prescriptions, medicines,
                            dosage, frequency and instructions.
                        </p>

                        <a asp-controller="Prescriptions"
                           asp-action="Index"
                           class="btn btn-secondary">
                            View Prescriptions
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Hospital Staff Login -->
    <div class="bg-primary text-white rounded-3 shadow-sm p-5 mb-5">
        <div class="row align-items-center">

            <div class="col-md-8">
                <h2 class="fw-bold">
                    Hospital Staff Login
                </h2>

                <p class="mb-0">
                    Authorized administrators, doctors and receptionists
                    can log in to access their respective dashboards
                    and manage hospital information.
                </p>
            </div>

            <div class="col-md-4 text-md-end mt-4 mt-md-0">
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-light btn-lg">
                    🔐 Login to System
                </a>
            </div>

        </div>
    </div>

    <!-- Why Use This System -->
    <div class="bg-light rounded-3 p-5 mb-5">

        <div class="text-center mb-4">
            <h2 class="fw-bold">
                Why Use This System?
            </h2>

            <p class="text-muted">
                Designed to make hospital administration simple and organized.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4 text-center">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="fw-bold">
                            Centralized Records
                        </h4>

                        <p class="text-muted">
                            Keep important hospital information
                            organized in one system.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 text-center">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="fw-bold">
                            Easy Management
                        </h4>

                        <p class="text-muted">
                            Add, view, update and remove records
                            through an easy-to-use interface.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 text-center">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="fw-bold">
                            Organized Workflow
                        </h4>

                        <p class="text-muted">
                            Connect patients, doctors, appointments,
                            medicines and prescriptions.
                        </p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Technologies Used -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body p-4">
            <div class="row align-items-center">

                <div class="col-md-8">
                    <h3 class="fw-bold">
                        Technologies Used
                    </h3>

                    <p class="text-muted mb-0">
                        This Hospital Management System is built using
                        modern Microsoft technologies and follows the
                        MVC architecture.
                    </p>
                </div>

                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <span class="badge bg-primary fs-6 m-1">
                        ASP.NET Core MVC
                    </span>

                    <span class="badge bg-dark fs-6 m-1">
                        C#
                    </span>

                    <span class="badge bg-success fs-6 m-1">
                        SQL Server
                    </span>

                    <span class="badge bg-secondary fs-6 m-1">
                        Entity Framework Core
                    </span>
                </div>

            </div>
        </div>
    </div>

    <!-- About the Author -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-header bg-primary text-white p-3">
            <h3 class="fw-bold mb-0">
                About the Author
            </h3>
        </div>

        <div class="card-body p-4">
            <div class="row align-items-center">

                <!-- Author Photo -->
                <div class="col-md-3 text-center mb-4 mb-md-0">

                    <img src="~/images/author.jpg"
                         alt="Author profile photo"
                         class="author-photo shadow"
                         asp-append-version="true" />

                    <h5 class="fw-bold mt-3 mb-1">
                        Adnan Kauser
                    </h5>

                    <p class="text-muted mb-0">
                        I hold a B.Tech degree in Computer Science.
                        I have an interest in software development and web application design.
                        I developed the Hospital Management System to streamline hospital operations.
                        The application manages patients, doctors, appointments, medicines, and prescriptions.
                        **Programming Language:** C#
                        **Framework:** ASP.NET Core MVC
                        **Database:** Microsoft SQL Server
                        **ORM:** Entity Framework Core
                        **Web Technologies:** HTML, CSS, JavaScript, and Bootstrap.
                        This project demonstrates my technical skills in application development and database management.
                    </p>

                </div>

                <!-- Author Information -->
                <div class="col-md-9">

                    <h4 class="fw-bold text-primary">
                        Hospital Management System
                    </h4>

                    <p class="text-muted">
                        This project is developed as a web-based
                        Hospital Management System to simplify hospital
                        operations and organize healthcare information.
                    </p>

                    <div class="row g-3 mt-2">

                        <div class="col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <h6 class="fw-bold">
                                    Project Title
                                </h6>

                                <p class="mb-0">
                                    Hospital Management System
                                </p>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <h6 class="fw-bold">
                                    Project Type
                                </h6>

                                <p class="mb-0">
                                    Web Application
                                </p>
                            </div>
                        </div>

                        <div class="col-12">
                            <h6 class="fw-bold mt-2">
                                Technologies Used
                            </h6>

                            <span class="badge bg-primary m-1">
                                ASP.NET Core MVC
                            </span>

                            <span class="badge bg-dark m-1">
                                C#
                            </span>

                            <span class="badge bg-success m-1">
                                SQL Server
                            </span>

                            <span class="badge bg-secondary m-1">
                                Entity Framework Core
                            </span>

                            <span class="badge bg-info text-dark m-1">
                                Web API
                            </span>

                            <span class="badge bg-warning text-dark m-1">
                                HTML, CSS &amp; JavaScript
                            </span>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Footer Information -->
    <div class="text-center py-4 border-top">

        <h5 class="fw-bold">
            Hospital Management System
        </h5>

        <p class="text-muted mb-1">
            A centralized solution for managing hospital information.
        </p>

        <small class="text-muted">
            Developed using ASP.NET Core MVC and SQL Server.
        </small>

    </div>

</div>
