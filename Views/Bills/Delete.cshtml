@model HospitalManagementSystem.Models.Bill

@{
    ViewData["Title"] = "Delete Bill";
}

<div class="container my-4">

    <!-- Page Header -->
    <div class="mb-4">

        <h2 class="fw-bold text-danger">
            Delete Bill
        </h2>

        <p class="text-muted">
            Please review the bill information before deleting it.
        </p>

    </div>


    <!-- Warning -->
    <div class="alert alert-danger shadow-sm">

        <div class="d-flex align-items-center">

            <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>

            <div>

                <h5 class="fw-bold mb-1">
                    Are you sure you want to delete this bill?
                </h5>

                <p class="mb-0">
                    This action cannot be undone.
                </p>

            </div>

        </div>

    </div>


    <!-- Bill Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Bill Information
                </h5>

                <span class="badge bg-light text-dark">
                    Bill #@Model.BillId
                </span>

            </div>

        </div>


        <div class="card-body">

            <!-- Patient Information -->
            <div class="row mb-4">

                <div class="col-md-6">

                    <h6 class="fw-bold text-primary mb-3">
                        Patient Information
                    </h6>

                    <p class="mb-2">

                        <strong>Patient Name:</strong>

                        @(Model.Patient?.PatientName ?? "N/A")

                    </p>

                    <p class="mb-2">

                        <strong>Patient ID:</strong>

                        @Model.PatientId

                    </p>

                    <p class="mb-2">

                        <strong>Phone:</strong>

                        @(Model.Patient?.Phone ?? "N/A")

                    </p>

                    <p class="mb-0">

                        <strong>Email:</strong>

                        @(Model.Patient?.Email ?? "N/A")

                    </p>

                </div>


                <!-- Bill Information -->
                <div class="col-md-6 mt-3 mt-md-0">

                    <h6 class="fw-bold text-primary mb-3">
                        Billing Information
                    </h6>

                    <p class="mb-2">

                        <strong>Bill Date:</strong>

                        @Model.BillDate.ToString("dd-MM-yyyy")

                    </p>

                    <p class="mb-2">

                        <strong>Payment Status:</strong>

                        @if (Model.PaymentStatus == "Paid")
                        {
                            <span class="badge bg-success">
                                Paid
                            </span>
                        }
                        else if (Model.PaymentStatus == "Pending")
                        {
                            <span class="badge bg-warning text-dark">
                                Pending
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                @Model.PaymentStatus
                            </span>
                        }

                    </p>

                    <p class="mb-0">

                        <strong>Payment Method:</strong>

                        @(Model.PaymentMethod ?? "Not specified")

                    </p>

                </div>

            </div>


            <!-- Charges -->
            <h6 class="fw-bold text-primary mb-3">
                Charges
            </h6>

            <div class="table-responsive">

                <table class="table table-bordered">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Description
                            </th>

                            <th class="text-end">
                                Amount
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <tr>

                            <td>
                                Consultation Fee
                            </td>

                            <td class="text-end">
                                ₹@Model.ConsultationFee.ToString("N2")
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Medicine Charges
                            </td>

                            <td class="text-end">
                                ₹@Model.MedicineCharges.ToString("N2")
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Laboratory Charges
                            </td>

                            <td class="text-end">
                                ₹@Model.LabCharges.ToString("N2")
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Room Charges
                            </td>

                            <td class="text-end">
                                ₹@Model.RoomCharges.ToString("N2")
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Other Charges
                            </td>

                            <td class="text-end">
                                ₹@Model.OtherCharges.ToString("N2")
                            </td>

                        </tr>


                        <tr>

                            <td class="text-end fw-semibold">
                                Subtotal
                            </td>

                            <td class="text-end fw-semibold">

                                ₹@(
                                    (
                                        Model.ConsultationFee +
                                        Model.MedicineCharges +
                                        Model.LabCharges +
                                        Model.RoomCharges +
                                        Model.OtherCharges
                                    ).ToString("N2")
                                )

                            </td>

                        </tr>


                        <tr>

                            <td class="text-end fw-semibold">
                                Discount
                            </td>

                            <td class="text-end text-danger fw-semibold">

                                - ₹@Model.Discount.ToString("N2")

                            </td>

                        </tr>


                        <tr class="table-primary">

                            <td class="text-end fw-bold fs-5">
                                Total Amount
                            </td>

                            <td class="text-end fw-bold fs-5">

                                ₹@Model.TotalAmount.ToString("N2")

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- Notes -->
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="mt-4">

                    <h6 class="fw-bold text-primary">
                        Notes
                    </h6>

                    <div class="alert alert-light border">
                        @Model.Notes
                    </div>

                </div>
            }

        </div>

    </div>


    <!-- Delete Form -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Delete"
                  asp-route-id="@Model.BillId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="BillId" />


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash"></i>

                        Yes, Delete Bill

                    </button>


                    <a asp-action="Details"
                       asp-route-id="@Model.BillId"
                       class="btn btn-info text-white">

                        <i class="bi bi-eye"></i>

                        View Bill

                    </a>


                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>