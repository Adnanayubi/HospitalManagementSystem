@model HospitalManagementSystem.Models.Medicine

@{
    ViewData["Title"] = "Medicine Details";
}

<h1>Medicine Details</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Medicine ID
    </dt>

    <dd class="col-sm-9">
        @Model.MedicineId
    </dd>


    <dt class="col-sm-3">
        Medicine Name
    </dt>

    <dd class="col-sm-9">
        @Model.MedicineName
    </dd>


    <dt class="col-sm-3">
        Generic Name
    </dt>

    <dd class="col-sm-9">
        @Model.GenericName
    </dd>


    <dt class="col-sm-3">
        Category
    </dt>

    <dd class="col-sm-9">
        @Model.Category
    </dd>


    <dt class="col-sm-3">
        Dosage
    </dt>

    <dd class="col-sm-9">
        @Model.Dosage
    </dd>


    <dt class="col-sm-3">
        Manufacturer
    </dt>

    <dd class="col-sm-9">
        @Model.Manufacturer
    </dd>


    <dt class="col-sm-3">
        Price
    </dt>

    <dd class="col-sm-9">
        ₹@Model.Price.ToString("0.00")
    </dd>


    <dt class="col-sm-3">
        Stock Quantity
    </dt>

    <dd class="col-sm-9">
        @Model.StockQuantity
    </dd>


    <dt class="col-sm-3">
        Expiry Date
    </dt>

    <dd class="col-sm-9">
        @Model.ExpiryDate?.ToString("dd-MM-yyyy")
    </dd>


    <dt class="col-sm-3">
        Description
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

</dl>

<hr />

<div>

    <a asp-action="Edit"
       asp-route-id="@Model.MedicineId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

</div>