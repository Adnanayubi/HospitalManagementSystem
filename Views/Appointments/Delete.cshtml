@model HospitalManagementSystem.Models.Appointment

@{
    ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>

<div class="alert alert-danger">
    <strong>Warning!</strong>
    Are you sure you want to delete this appointment?
</div>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Appointment ID
    </dt>

    <dd class="col-sm-9">
        @Model.AppointmentId
    </dd>


    <dt class="col-sm-3">
        Patient
    </dt>

    <dd class="col-sm-9">
        @Model.Patient?.PatientName
    </dd>


    <dt class="col-sm-3">
        Doctor
    </dt>

    <dd class="col-sm-9">
        @Model.Doctor?.DoctorName
    </dd>


    <dt class="col-sm-3">
        Appointment Date
    </dt>

    <dd class="col-sm-9">
        @Model.AppointmentDate.ToString("dd-MM-yyyy")
    </dd>


    <dt class="col-sm-3">
        Appointment Time
    </dt>

    <dd class="col-sm-9">
        @Model.AppointmentTime.ToString(@"hh\:mm")
    </dd>


    <dt class="col-sm-3">
        Reason
    </dt>

    <dd class="col-sm-9">
        @Model.Reason
    </dd>


    <dt class="col-sm-3">
        Status
    </dt>

    <dd class="col-sm-9">
        @Model.Status
    </dd>

</dl>

<hr />

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="AppointmentId" />

    <button type="submit"
            class="btn btn-danger">
        Delete Appointment
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>