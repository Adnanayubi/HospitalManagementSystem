@model HospitalManagementSystem.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
}

<h1>Delete Doctor</h1>

<h3>Are you sure you want to delete this doctor?</h3>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.DoctorId)
    </dt>

    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.DoctorId)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.DoctorName)
    </dt>

    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.DoctorName)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Specialization)
    </dt>

    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Specialization)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Phone)
    </dt>

    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Phone)
    </dd>

    <dt class="col-sm-3">
        @Html.DisplayNameFor(model => model.Email)
    </dt>

    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Email)
    </dd>

    <dt class="col-sm-3">
        Department
    </dt>

    <dd class="col-sm-9">
        @Html.DisplayFor(model => model.Department.DepartmentName)
    </dd>

</dl>

<form asp-action="Delete" method="post">

    <input type="hidden"
           asp-for="DoctorId" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>